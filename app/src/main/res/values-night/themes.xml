        <!-- Spinner Styles
        <item name="spinnerStyle">@style/MySpinnerStyle</item>
        <item name="android:spinnerStyle">@style/MySpinnerStyle</item>-->

        <!-- Switch Styles
        <item name="switchStyle">@style/MySwitchStyle</item>
        <item name="android:switchStyle">@style/MySwitchStyle</item>-->

        <!-- Toolbar Styles
        <item name="toolbarStyle">@style/MyToolbarStyle</item>
        <item name="android:toolbarStyle">@style/MyToolbarStyle</item>-->

        <!-- Window Styles
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>-->

        <!-- Icon Tint
        <item name="iconTint">@color/primaryText</item>-->
    </style>
