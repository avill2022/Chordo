<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyShellApplicationKotlinXML" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Primary Colors
        <item name="colorPrimary">@color/primaryLight</item>
        <item name="colorPrimaryDark">@color/primaryDark</item>
    <item name="android:statusBarColor">@color/primaryDark</item>  Status bar -->

        <!-- Background Colors
        <item name="android:windowBackground">@color/backgroundDark</item>
